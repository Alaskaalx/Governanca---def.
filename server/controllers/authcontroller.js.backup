// ============================================================================
// FUNÇÃO ÚNICA: LOGIN LDAP COM CRIAÇÃO DE PERFIL AUTOMÁTICA (CRIPTOGRAFADO)
// ============================================================================
export const login = async (req, res) => {
    try {
        const { username, password, modulo_id } = req.body;
        const ipMaquina = req.headers['x-forwarded-for'] || req.connection.remoteAddress || req.ip;
        
        // Puxa a chave de criptografia do .env
        const chaveCrip = process.env.CHAVE_CRIPTOGRAFIA;

        if (!username || !password) {
            return res.status(400).json({ sucesso: false, mensagem: "Preencha usuário e senha." });
        }

        const tabelas_modulos = {
            1: { tabela: 'login_compliance', url: 'painel_governanca.html' },
            2: { tabela: 'login_monitoramento', url: 'painel_monitoramento.html' },
            3: { tabela: 'login_auditoria_sites', url: 'painel_auditoria_sites.html' },
            4: { tabela: 'login_auditoria_processos', url: 'painel_auditoria_processos.html' },
            5: { tabela: 'login_gestao_medidas', url: 'painel_gestao_medidas.html' }
        };

        if (!tabelas_modulos[modulo_id]) {
            return res.status(400).json({ sucesso: false, mensagem: "Módulo inválido." });
        }

        const { tabela: nome_tabela, url: url_destino } = tabelas_modulos[modulo_id];
        const userPrincipalName = username.includes('@') ? username : `${username}${configAD.domain}`;
        const ad = new ActiveDirectory(configAD);

        const adAuthenticate = (upn, pass) => new Promise((resolve, reject) => {
            ad.authenticate(upn, pass, (err, auth) => { if (err) return reject(err); resolve(auth); });
        });

        const adFindUser = (upn) => new Promise((resolve, reject) => {
            ad.findUser(upn, (err, user) => { if (err) return reject(err); resolve(user); });
        });

        // 1. TENTA AUTENTICAR NO AD E REGISTRA FALHA SE A SENHA ESTIVER ERRADA
        let authLDAP = false;
        try {
            authLDAP = await adAuthenticate(userPrincipalName, password);
        } catch (err) {
            console.error("❌ Erro de comunicação ou rejeição no AD:", err.message);
            await registrarLogAcesso(username, 'N/A', ipMaquina, nome_tabela, 'LOGIN_FALHO', 'Senha incorreta ou erro de comunicação no servidor AD.');
            return res.status(401).json({ sucesso: false, mensagem: "Usuário ou senha inválidos no sistema corporativo." });
        }

        if (!authLDAP) {
            await registrarLogAcesso(username, 'N/A', ipMaquina, nome_tabela, 'LOGIN_FALHO', 'Senha incorreta no Active Directory.');
            return res.status(401).json({ sucesso: false, mensagem: "Senha incorreta." });
        }

        // 2. SE A SENHA É VÁLIDA NA REDE, OLHAMOS O NOSSO BANCO (MYSQL)
        // Modificado: Buscamos comparando o username criptografado e descriptografamos o restante no SELECT
        const querySelect = `
            SELECT id, 
                   CAST(AES_DECRYPT(username, ?) AS CHAR) AS username, 
                   CAST(AES_DECRYPT(nome, ?) AS CHAR) AS nome, 
                   CAST(AES_DECRYPT(email, ?) AS CHAR) AS email, 
                   perfil, ativo 
            FROM ${nome_tabela} 
            WHERE username = AES_ENCRYPT(?, ?)
        `;
        const [rows] = await db.query(querySelect, [chaveCrip, chaveCrip, chaveCrip, username, chaveCrip]);
        let usuario = rows[0];

        if (usuario) {
            if (usuario.ativo === 0 || usuario.ativo === false) {
                await registrarLogAcesso(username, usuario.perfil, ipMaquina, nome_tabela, 'LOGIN_FALHO', 'Acesso negado: Usuário desativado no sistema local.');
                return res.status(401).json({ sucesso: false, mensagem: "Seu usuário está desativado neste módulo." });
            }
        } else {
            let nomeCompleto = username;
            let emailAD = '';
            try {
                const dadosAD = await adFindUser(userPrincipalName);
                if (dadosAD) { 
                    nomeCompleto = dadosAD.displayName || username; 
                    emailAD = dadosAD.mail || ''; 
                }
            } catch (e) {}

            // Modificado: O INSERT agora insere os dados aplicando a criptografia AES_ENCRYPT
            const queryInsert = `
                INSERT INTO ${nome_tabela} (username, nome, email, perfil, ativo) 
                VALUES (AES_ENCRYPT(?, ?), AES_ENCRYPT(?, ?), AES_ENCRYPT(?, ?), 'usuario', 1)
            `;
            const [resultInsert] = await db.query(queryInsert, [
                username, chaveCrip, 
                nomeCompleto, chaveCrip, 
                emailAD, chaveCrip
            ]);
            
            usuario = { id: resultInsert.insertId, username: username, perfil: 'usuario' };
        }

        // 3. REGISTRA A SESSÃO E O SUCESSO DO LOGIN NO ARQUIVO TXT
        req.session.usuario_id = usuario.id;
        req.session.usuario_nome = usuario.username; 
        req.session.usuario_perfil = String(usuario.perfil).toLowerCase();
        req.session.modulo_atual = nome_tabela;

        await registrarLogAcesso(username, usuario.perfil, ipMaquina, nome_tabela, 'LOGIN_SUCESSO', 'Autenticação AD validada e acesso concedido.');

        return res.json({ sucesso: true, primeiro_acesso: false, url_destino: url_destino, perfil: usuario.perfil });

    } catch (error) {
        console.error("Erro interno no login:", error);
        return res.status(500).json({ sucesso: false, mensagem: "Erro interno no servidor de autenticação." });
    }
};